---
import "@/styles/global.css"

interface Props {
	title?: string
}

const { title = "Gordon Freeman" } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/orange-crowbar.svg" />
		<link rel="icon" href="/orange-crowbar.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
